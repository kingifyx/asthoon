{
  "schemaVersion": 1,
  "id": "asthoonlite",
  "version": "${version}",
  "name": "AsthoonLite",
  "description": "QOL, dungeon, mining, fishing, nucleus and funny helpers for Hypixel Skyblock.",
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "adapter": "kotlin",
        "value": "com.asthoonlite.AsthoonLite"
      }
    ]
  },
  "mixins": [
    "asthoonlite.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.1.2",
    "java": ">=25",
    "fabric-language-kotlin": ">=1.13.12+kotlin.2.4.0"
  }
}
